+// Divergent logs (Raft Fig. 7/8): the isolated leader appends a client
+// entry it can never commit; the majority elects a new leader that commits
+// different entries; after the heal the old leader steps down and its
+// uncommitted suffix is overwritten (HeartbeatReject / Mismatch / Overwrite).
+func TestTLATrace_leader_isolate_divergent_overwrite(t *testing.T) {
+	onlyBubbled(t, func(t *testing.T) {
+		h := newTlaHarness(t, "leader_isolate_divergent_overwrite", 3, 3, nil)
+		h.startInitial()
+		lead, ok := h.leader(30*time.Second, nil)
+		if !ok {
+			h.finish()
+			t.Fatal("no leader elected")
+		}
+		h.sleep(time.Second)
+		h.writes3(lead)
+		h.note("isolate leader %v", h.c.Nodes[lead].name)
+		h.isolate(lead)
+		err := h.write(lead, 2*time.Second) // appended at the old leader, never committed
+		h.note("write on isolated old leader %v: err=%v", h.c.Nodes[lead].name, err)
+		h.sleep(8 * time.Second)
+		for i := range h.c.Nodes {
+			if i == lead {
+				continue
+			}
+			if l := h.look(i); l != nil && l.Role == LEADER {
+				h.note("majority leader %v", h.c.Nodes[i].name)
+				h.writes3(i)
+				break
+			}
+		}
+		h.note("heal")
+		h.heal()
+		h.sleep(12 * time.Second)
+		if l, ok := h.leader(20*time.Second, nil); ok {
+			h.writes3(l)
+		}
+		h.sleep(3 * time.Second)
+		h.finish()
+	})
+}
