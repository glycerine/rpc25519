+// ---------------------------------------------------------------------
+// scenarios
+// ---------------------------------------------------------------------
+
+// Cold start of a 3-node cluster: startup dials and circuit registration
+// (duplicate circuits from the two-way dials), pre-vote, election, noop0
+// commit, client writes, heartbeats, and the 20 s audit GC.
+func TestTLATrace_cold_start_election(t *testing.T) {
+	onlyBubbled(t, func(t *testing.T) {
+		h := newTlaHarness(t, "cold_start_election", 3, 3, nil)
+		h.startInitial()
+		lead, ok := h.leader(30*time.Second, nil)
+		if !ok {
+			h.note("no leader elected")
+			h.finish()
+			t.Fatal("no leader elected")
+		}
+		h.note("leader %v elected", h.c.Nodes[lead].name)
+		h.sleep(time.Second)
+		h.writes3(lead)
+		h.sleep(25 * time.Second) // heartbeats + AuditGC at 20 s
+		h.writes3(lead)
+		h.sleep(2 * time.Second)
+		h.finish()
+	})
+}
+
+// Leader crash: the survivors elect a new leader; the old leader restarts
+// with a new PeerID (incarnation 1) and rejoins as a follower.
+func TestTLATrace_leader_crash_restart(t *testing.T) {
+	onlyBubbled(t, func(t *testing.T) {
+		h := newTlaHarness(t, "leader_crash_restart", 3, 3, nil)
+		h.startInitial()
+		lead, ok := h.leader(30*time.Second, nil)
+		if !ok {
+			h.finish()
+			t.Fatal("no leader elected")
+		}
+		h.sleep(time.Second)
+		h.writes3(lead)
+		h.note("crash leader %v", h.c.Nodes[lead].name)
+		h.crash(lead, nil)
+		down := map[int]bool{lead: true}
+		lead2, ok := h.leader(40*time.Second, down)
+		if ok {
+			h.note("new leader %v", h.c.Nodes[lead2].name)
+			h.writes3(lead2)
+		} else {
+			h.note("no new leader among survivors")
+		}
+		h.sleep(3 * time.Second)
+		h.note("restart %v", h.c.Nodes[lead].name)
+		h.startNode(lead)
+		h.sleep(15 * time.Second)
+		if l, ok := h.leader(20*time.Second, nil); ok {
+			h.writes3(l)
+		}
+		h.sleep(5 * time.Second)
+		h.finish()
+	})
+}
+
+// Follower crash and restart: writes continue on the majority; the
+// restarted follower (new PeerID) is caught up by AppendEntries.
+func TestTLATrace_follower_crash_restart(t *testing.T) {
+	onlyBubbled(t, func(t *testing.T) {
+		h := newTlaHarness(t, "follower_crash_restart", 3, 3, nil)
+		h.startInitial()
+		lead, ok := h.leader(30*time.Second, nil)
+		if !ok {
+			h.finish()
+			t.Fatal("no leader elected")
+		}
+		h.sleep(time.Second)
+		h.writes3(lead)
+		f := (lead + 1) % 3
+		h.note("crash follower %v", h.c.Nodes[f].name)
+		h.crash(f, nil)
+		h.sleep(2 * time.Second)
+		h.writes3(lead)
+		h.sleep(3 * time.Second)
+		h.note("restart follower %v", h.c.Nodes[f].name)
+		h.startNode(f)
+		h.sleep(15 * time.Second)
+		if l, ok := h.leader(20*time.Second, nil); ok {
+			h.writes3(l)
+		}
+		h.sleep(5 * time.Second)
+		h.finish()
+	})
+}
+
+// Symmetric partition of the leader: the majority elects a new leader in
+// a higher term; after healing, the old leader steps down and catches up.
+func TestTLATrace_leader_isolate_heal(t *testing.T) {
+	onlyBubbled(t, func(t *testing.T) {
+		h := newTlaHarness(t, "leader_isolate_heal", 3, 3, nil)
+		h.startInitial()
+		lead, ok := h.leader(30*time.Second, nil)
+		if !ok {
+			h.finish()
+			t.Fatal("no leader elected")
+		}
+		h.sleep(time.Second)
+		h.writes3(lead)
+		h.note("isolate leader %v", h.c.Nodes[lead].name)
+		h.isolate(lead)
+		h.sleep(12 * time.Second)
+		for i := range h.c.Nodes {
+			if i == lead {
+				continue
+			}
+			if l := h.look(i); l != nil && l.Role == LEADER {
+				h.note("majority leader %v", h.c.Nodes[i].name)
+				h.writes3(i)
+				break
+			}
+		}
+		h.note("heal")
+		h.heal()
+		h.sleep(15 * time.Second)
+		if l, ok := h.leader(20*time.Second, nil); ok {
+			h.writes3(l)
+		}
+		h.sleep(3 * time.Second)
+		h.finish()
+	})
+}
+
+// Asymmetric NIC failure at a follower: it still receives the leader's
+// AppendEntries but none of its frames get out; then the link heals.
+func TestTLATrace_follower_drop_sends(t *testing.T) {
