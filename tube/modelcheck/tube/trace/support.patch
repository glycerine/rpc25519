+// A well-formed, uncommitted WAL tail above every local protection point
+// can recover its missing identifier from its own bytes on the next start.
+func TestTLATrace_interrupted_uncommitted_tail(t *testing.T) {
+	onlyBubbled(t, func(t *testing.T) {
+		h := newTlaHarness(t, "interrupted_uncommitted_tail", 3, 3, nil)
+		h.startInitial()
+		leader, ok := h.leader(30*time.Second, nil)
+		if !ok {
+			h.finish()
+			t.Fatal("no leader elected")
+		}
+		h.writes3(leader)
+		h.isolate(leader)
+		_ = h.write(leader, 250*time.Millisecond)
+		before := h.look(leader)
+		if before.LastLogIndex <= before.State.CommitIndex {
+			h.finish()
+			t.Fatal("no uncommitted WAL tail")
+		}
+		h.crash(leader, map[string]any{"diskFault": "lastIdentifierTorn", "tornIdentifiers": 1})
+		h.tearLastIdentifier(leader)
+		h.sleep(2 * time.Second)
+		h.heal()
+		h.startNode(leader)
+		h.sleep(2 * time.Second)
+		h.sleep(4 * time.Second)
+		h.finish()
+	})
+}
