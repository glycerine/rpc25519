+// Log compaction and state-snapshot catch-up: every leader WAL append
+// compacts (tiny threshold); a crashed follower falls behind the leader's
+// compaction base and is restored by InstallSnapshot on restart.
+func TestTLATrace_compaction_snapshot(t *testing.T) {
+	onlyBubbled(t, func(t *testing.T) {
+		h := newTlaHarness(t, "compaction_snapshot", 3, 3, func(cfg *TubeConfig) {
+			cfg.CompactionThresholdBytes = 1
+		})
+		h.startInitial()
+		lead, ok := h.leader(30*time.Second, nil)
+		if !ok {
+			h.finish()
+			t.Fatal("no leader elected")
+		}
+		h.sleep(time.Second)
+		h.writes3(lead)
+		f := (lead + 1) % 3
+		h.note("crash follower %v", h.c.Nodes[f].name)
+		h.crash(f, nil)
+		h.sleep(time.Second)
+		h.writes3(lead)
+		h.writes3(lead)
+		h.sleep(2 * time.Second)
+		h.note("restart follower %v", h.c.Nodes[f].name)
+		h.startNode(f)
+		h.sleep(15 * time.Second)
+		if l, ok := h.leader(20*time.Second, nil); ok {
+			h.writes3(l)
+		}
+		h.sleep(5 * time.Second)
+		h.finish()
+	})
+}
