+package rpc25519
+
+// Transport hooks for the Tube implementation trace recorder.
+//
+// The rpc25519 transport cannot import the tube package, so transport-level
+// trace points (pump.go, srv.go, cli.go, ckt.go) report through this hook.
+// The tube package's tla_trace.go installs the hook while a trace is being
+// recorded; when no hook is installed every call is a cheap no-op.
+//
+// collect.sh adds this file to the isolated source checkout.
+
+import (
+	"context"
+	"sync/atomic"
+)
+
+// TLATransportEvent describes one transport-level step.
+type TLATransportEvent struct {
+	// Name is one of:
+	//   "NewCircuit"          ckt.go newCircuit: a circuit object was created
+	//                         (IsDialer: this side originated it, tellRemote).
+	//   "HandleEndCircuit"    pump.go: CallPeerEndCircuit closed the local end.
+	//   "DropUnroutable"      pump.go: frame for an unknown CallID dropped.
+	//   "DropStaleTarget"    srv.go/cli.go: a frame had no matching local
+	//                         ToPeerID and was discarded.
+	//   "ConnAbort"           srv.go/cli.go: read loop exited on a read error/EOF.
+	Name string
+
+	// pump / circuit events: the receiving LocalPeer.
+	LocalPeerID   string
+	LocalPeerName string
+
+	// read-loop events: owning server name (e.g. "srv_node_0") and the
+	// remote endpoint name/address of the connection.
+	ServerName string
+	RemoteName string
+
+	// frame identity
+	FromPeerID string
+	ToPeerID   string
+	CallID     string
+	MsgType    string
+
+	IsDialer bool
+}
+
+var tlaTransportHook atomic.Pointer[func(ev TLATransportEvent)]
+
+// SetTLATransportHook installs (or, with nil, removes) the transport hook.
+func SetTLATransportHook(h func(ev TLATransportEvent)) {
+	if h == nil {
+		tlaTransportHook.Store(nil)
+		return
+	}
+	tlaTransportHook.Store(&h)
+}
+
+// tlaTransport reports ev to the installed hook, if any.
+func tlaTransport(ev TLATransportEvent) {
+	if p := tlaTransportHook.Load(); p != nil {
+		(*p)(ev)
+	}
+}
+
+// tlaTransportOn is a cheap check used to avoid building events.
+func tlaTransportOn() bool {
+	return tlaTransportHook.Load() != nil
+}
+
+type tlaDialIDKey struct{}
+
+// WithTLADialID associates the watchdog call with its transport circuit.
+func WithTLADialID(ctx context.Context, out *string) context.Context {
+	return context.WithValue(ctx, tlaDialIDKey{}, out)
+}
