+//go:build synctest
+
+package tube
+
+// TLA+ implementation trace scenarios for Trace.tla.
+//
+// Every scenario runs the real Tube code: a disk-mode (NoDisk=false, PAR
+// active) cluster on the in-process simnet network inside a synctest
+// bubble.  The initial members cold-start from a persisted MemberConfig
+// (ConfigTerm 0, ConfigVersion 1, committed) and an empty WAL, exactly
+// the spec's Init with InitMeshed = FALSE: the startup connectToMC leaves
+// a pending, pulsed watchdog toward every other member.  All fault
+// injection goes through simnet (host shutdown, isolation, dropped sends /
+// deaf reads) and is logged as the spec's environment events.
+//
+// One NDJSON file per scenario: $TLA_TRACE_DIR/<scenario>.ndjson
+// (t.TempDir() when TLA_TRACE_DIR is unset).
+//
+// Run from tube/ in the instrumented checkout built by collect.sh.
+//	TLA_TRACE_DIR=/abs/traces go test -tags synctest -run 'TestTLATrace' -v .
+
+import (
+	"context"
+	"encoding/binary"
+	"fmt"
+	"hash/fnv"
+	"os"
+	"path/filepath"
+	"sort"
+	"testing"
+	"time"
+
+	rpc "github.com/glycerine/rpc25519"
+)
+
+type tlaHarness struct {
+	t        *testing.T
+	scenario string
+	c        *TubeCluster
+	cfg      *TubeConfig
+	root     string
+	path     string
+	members  []string // initial MC members
+	all      []string // every node name (members + later joiners)
+	writes   int
+}
+
+const tlaTestNum = 9100 // >= 400 avoids test-only single-node shortcuts
+
+// tlaScenarioSeed: 0 for cold_start_election, else an FNV-1a hash of the name.
+func tlaScenarioSeed(scenario string) int64 {
+	if scenario == "cold_start_election" {
+		return 0
+	}
+	h := fnv.New64a()
+	h.Write([]byte(scenario))
+	return int64(h.Sum64() & 0x7fffffffffffffff)
+}
+
+// newTlaHarness builds nTotal nodes; the first nInit are the initial MC.
+func newTlaHarness(t *testing.T, scenario string, nInit, nTotal int, tweak func(cfg *TubeConfig)) *tlaHarness {
+	h := &tlaHarness{t: t, scenario: scenario}
+	h.root = filepath.Join(t.TempDir(), "data")
+	cfg := NewTubeConfigTest(nTotal, "tla-"+scenario, faketime)
+	// Deterministic per-scenario seed for Tube's election-timeout PRNG and
+	// simnet's tie-breaking, so scenarios differ in election order/timing
+	// (cold_start_election keeps the default all-zero seed).
+	seed := tlaScenarioSeed(scenario)
+	if seed != 0 {
+		var b [32]byte
+		binary.LittleEndian.PutUint64(b[:], uint64(seed))
+		cfg.prng = newPRNG(b)
+		cfg.InitialSimnetScenario = seed
+		cfg.RpcCfg.InitialSimnetScenario = seed
+	}
+	cfg.NoDisk = false // the spec models disk mode only (PAR active)
+	cfg.testNum = tlaTestNum
+	// one client ticket per replicateBatch => one entry per ClientRequest
+	cfg.BatchAccumulateDur = time.Microsecond
+	if tweak != nil {
+		tweak(cfg)
+	}
+	h.cfg = cfg
+	c := NewCluster(t.Name(), cfg)
+	h.c = c
+
+	for i, node := range c.Nodes {
+		h.all = append(h.all, node.name)
+		if i < nInit {
+			h.members = append(h.members, node.name)
+		}
+	}
+	// persisted initial state: MC (ct 0, cv 1, committed) naming every
+	// initial member at its listen address; empty WAL; term 0.
+	mc := c.Nodes[0].NewMemberConfig("tla trace initial MC")
+	mc.ConfigTerm, mc.ConfigVersion, mc.IsCommitted = 0, 1, true
+	for _, name := range h.members {
+		mc.PeerNames.Set(name, &PeerDetail{
+			Name:            name,
+			URL:             "simnet://srv_" + name + "/" + TUBE_REPLICA + "/",
+			Addr:            "simnet://srv_" + name,
+			PeerServiceName: TUBE_REPLICA,
+		})
+	}
+	for i, node := range c.Nodes {
+		node.cfg.DataDir = filepath.Join(h.root, node.name)
+		if err := os.MkdirAll(node.cfg.DataDir, 0700); err != nil {
+			t.Fatal(err)
+		}
+		if i >= nInit {
+			continue // joiners start with no persisted state (empty MC)
+		}
+		// an empty WAL (and PAR sidecar) next to the state: a persisted
+		// state without its WAL files makes PAR fence the node (unknown).
+		wal, err := node.cfg.newRaftWriteAheadLog(filepath.Join(node.cfg.DataDir, "tube.wal.msgp"), false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := wal.close(); err != nil {
+			t.Fatal(err)
+		}
+		st := node.state
+		st.CurrentTerm, st.VotedFor = 0, ""
+		st.MC = mc.Clone()
+		saver, _, err := node.cfg.NewRaftStatePersistor(node.GetPersistorPath(), node, false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := saver.save(st); err != nil {
+			t.Fatal(err)
+		}
+		saver.close()
+	}
+
+	dir := os.Getenv("TLA_TRACE_DIR")
+	if dir == "" {
+		dir = t.TempDir()
+	}
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		t.Fatal(err)
+	}
+	h.path = filepath.Join(dir, scenario+".ndjson")
+	err := TlaTraceStart(h.path, h.members, map[string]any{
+		"scenario":           scenario,
+		"allNodes":           h.all,
+		"heartbeatDur":       cfg.HeartbeatDur.String(),
+		"minElectionDur":     cfg.MinElectionDur.String(),
+		"clockDriftBound":    cfg.ClockDriftBound.String(),
+		"batchAccumulateDur": cfg.BatchAccumulateDur.String(),
+		"compactionBytes":    cfg.CompactionThresholdBytes,
+		"noLogCompaction":    cfg.NoLogCompaction,
+		"noDisk":             cfg.NoDisk,
+		"initCfg":            map[string]any{"ct": 0, "cv": 1, "com": true},
+		"seed":               seed,
+		"simnet":             true,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return h
+}
+
+func (h *tlaHarness) note(format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	TlaNote(msg)
+	h.t.Logf("[%v] %v", h.scenario, msg)
+}
+
+// startInitial brings the initial members up together (the spec's Init has
+// every initial member up): it is InitAndStart split in two phases so that
+// every simnet server is registered before any Tube replica starts and
+// fires its startup dials (otherwise the first node's dials find no server).
+func (h *tlaHarness) startInitial() {
+	n := len(h.members)
+	for i := 0; i < n; i++ { // phase 1: listen
+		s := h.c.Nodes[i]
+		s.started = true
+		s.srvname = "srv_" + s.name
+		s.Srv = rpc.NewServer(s.srvname, s.cfg.RpcCfg)
+		addr, err := s.Srv.Start()
+		if err != nil {
+			h.t.Fatal(err)
+		}
+		s.rpcServerAddr = addr
+	}
+	for i := 0; i < n; i++ { // phase 2: start the replicas back to back
+		s := h.c.Nodes[i]
+		if err := s.Srv.PeerAPI.RegisterPeerServiceFunc(string(s.PeerServiceName), s.Start); err != nil {
+			h.t.Fatal(err)
+		}
+		if _, err := s.Srv.PeerAPI.StartLocalPeer(context.Background(), string(s.PeerServiceName), binVersion, nil, s.name, true); err != nil {
+			h.t.Fatal(err)
+		}
+		h.sleep(20 * time.Millisecond) // permit the first handshakes before opposing dials start
+	}
+	for i := 0; i < n; i++ {
+		s := h.c.Nodes[i]
+		select {
+		case <-s.startupNodeUrlSafeCh.Chan:
+		case <-s.Halt.ReqStop.Chan:
+			h.t.Fatal("node halted during start")
+		}
+	}
+}
+
+// startNode starts a node that was not running (a joiner's first start
+// or a restart after crash): the spec's Restart(n, a).
+func (h *tlaHarness) startNode(i int) {
+	old := h.c.Nodes[i]
+	if old.started {
+		node := NewTubeNode(old.name, &old.cfg)
+		h.c.Nodes[i] = node
+		h.c.Halt.AddChild(node.Halt)
+	}
+	if err := h.c.Nodes[i].InitAndStart(); err != nil {
+		h.t.Fatal(err)
+	}
+}
+
+func (h *tlaHarness) simnet() *rpc.Simnet {
+	return h.cfg.RpcCfg.GetSimnet()
+}
+
+// settle is a placeholder for a quiescence point.  It must not call
+// synctest.Wait(): simnet's scheduler calls it on every tick, and two
+// concurrent Wait calls in one bubble panic ("wait already in progress").
+func (h *tlaHarness) settle() {}
+
+func (h *tlaHarness) sleep(d time.Duration) {
+	time.Sleep(d)
+}
+
+func (h *tlaHarness) look(i int) *Inspection {
+	look := h.c.Nodes[i].Inspect()
+	if look != nil && look.State != nil && look.State.KVstore != nil {
+		look.State.KVstore.Close()
+	}
+	return look
+}
+
+// leader polls until exactly one running node is LEADER (up to limit).
+func (h *tlaHarness) leader(limit time.Duration, down map[int]bool) (int, bool) {
+	deadline := time.Now().Add(limit)
+	for {
+		lead := -1
+		n := 0
+		for i := range h.c.Nodes {
+			if down[i] || !h.c.Nodes[i].started {
+				continue
+			}
+			if l := h.look(i); l != nil && l.Role == LEADER {
+				lead = i
+				n++
+			}
+		}
+		if n == 1 {
+			return lead, true
+		}
+		if time.Now().After(deadline) {
+			return -1, false
+		}
+		time.Sleep(100 * time.Millisecond)
+	}
+}
+
+// write submits one client write on the current leader and waits for it.
+func (h *tlaHarness) write(lead int, limit time.Duration) error {
+	h.writes++
+	ctx, cancel := context.WithTimeout(context.Background(), limit)
+	defer cancel()
+	key := Key(fmt.Sprintf("k%d", h.writes))
+	_, err := h.c.Nodes[lead].Write(ctx, "", key, Val(fmt.Sprintf("v%d", h.writes)), 0, nil, "", 0, false)
+	return err
+}
+
+func (h *tlaHarness) writes3(lead int) {
+	for j := 0; j < 3; j++ {
+		if err := h.write(lead, 5*time.Second); err != nil {
+			h.note("write on %v failed: %v", h.c.Nodes[lead].name, err)
+			return
+		}
+	}
+}
+
+// crash powers off node i's host: its network goes dark at once (no
+// orderly close frames reach anyone; the peers' connection ends stay
+// half-open), then the process is stopped.  Crash(n).
+//
+// simnet cannot produce a process crash on a live host (FIN/RST to the
+// peers): its message-level read returns a remote close as an ordinary
+// message, so a peer's read loop never fails (no ConnAbort).  detail
+// fields are logged on the Crash event (e.g. the disk fault applied).
+func (h *tlaHarness) crash(i int, detail map[string]any) {
+	node := h.c.Nodes[i]
+	h.settle()
+	if detail == nil {
+		detail = map[string]any{}
+	}
+	detail["kind"] = "hostPowerOff"
+	TlaCrash(node.name, detail)
+	if _, err := h.simnet().AlterHost(node.srvname, rpc.SHUTDOWN); err != nil {
+		h.t.Logf("AlterHost SHUTDOWN %v: %v", node.srvname, err)
+	}
+	node.Close()
+	h.settle()
+}
+
+// walPath is node i's WAL file; its PAR identifier sidecar is walPath+".parlog".
+func (h *tlaHarness) walPath(i int) string {
+	return filepath.Join(h.c.Nodes[i].cfg.DataDir, "tube.wal.msgp")
+}
+
+// tearLastIdentifier removes the last published PAR identifier of a dead
+// node's WAL: the state a crash between the entry fsync and the identifier
+// publication leaves (the spec's torn append, idLen = Len(log) - 1).
+func (h *tlaHarness) tearLastIdentifier(i int) {
+	par := h.walPath(i) + ".parlog"
+	fi, err := os.Stat(par)
+	if err != nil {
+		h.t.Fatal(err)
+	}
+	if fi.Size() < maxParRecord {
+		h.t.Fatalf("no identifier to tear in %v (size %v)", par, fi.Size())
+	}
+	if err := os.Truncate(par, fi.Size()-maxParRecord); err != nil {
+		h.t.Fatal(err)
+	}
+}
+
+// loseWAL deletes a dead node's WAL and identifier sidecar, keeping its
+// persisted RaftState (disk loss of the log files).
+func (h *tlaHarness) loseWAL(i int) {
+	for _, p := range []string{h.walPath(i), h.walPath(i) + ".parlog"} {
+		if err := os.Remove(p); err != nil && !os.IsNotExist(err) {
+			h.t.Fatal(err)
+		}
+	}
+}
+
+// isolate cuts node i off from everyone (both directions).
+func (h *tlaHarness) isolate(i int) {
+	node := h.c.Nodes[i]
+	h.settle()
+	if _, err := h.simnet().AlterHost(node.srvname, rpc.ISOLATE); err != nil {
+		h.t.Fatal(err)
+	}
+	for _, other := range h.all {
+		if other == node.name {
+			continue
+		}
+		TlaLink(false, node.name, other)
+		TlaLink(false, other, node.name)
+	}
+}
+
+// dropSends: node i's outgoing frames are dropped (asymmetric NIC failure).
+func (h *tlaHarness) dropSends(i int) {
+	node := h.c.Nodes[i]
+	h.settle()
+	node.DropSends(1)
+	for _, other := range h.all {
+		if other != node.name {
+			TlaLink(false, node.name, other)
+		}
+	}
+}
+
+// deafReads: node i cannot receive (asymmetric NIC failure).
+func (h *tlaHarness) deafReads(i int) {
+	node := h.c.Nodes[i]
+	h.settle()
+	node.DeafToReads(1)
+	for _, other := range h.all {
+		if other != node.name {
+			TlaLink(false, other, node.name)
+		}
+	}
+}
+
+// heal restores every link; frames held back during the fault are
+// delivered (TCP retransmission), as in the spec where they stay queued.
+func (h *tlaHarness) heal() {
+	h.settle()
+	for _, l := range TlaLinksDown() {
+		TlaLink(true, l[0], l[1])
+	}
+	if err := h.simnet().AllHealthy(false, true); err != nil {
+		h.t.Fatal(err)
+	}
+}
+
+func (h *tlaHarness) finish() {
+	h.settle()
+	lines, counts := TlaTraceStop()
+	names := make([]string, 0, len(counts))
+	for k := range counts {
+		names = append(names, k)
+	}
+	sort.Strings(names)
+	summary := ""
+	for _, k := range names {
+		summary += fmt.Sprintf(" %v=%v", k, counts[k])
+	}
+	h.t.Logf("[%v] trace %v: %v events:%v", h.scenario, h.path, lines, summary)
+	h.c.Close()
+}
+
+func (h *tlaHarness) idx(name string) int {
+	for i, node := range h.c.Nodes {
+		if node.name == name {
+			return i
+		}
+	}
+	return -1
+}
