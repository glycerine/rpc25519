+			h.finish()
+			t.Fatal("no leader elected")
+		}
+		h.sleep(time.Second)
+		h.writes3(lead)
+		f := (lead + 1) % 3
+		h.note("follower %v drops all sends", h.c.Nodes[f].name)
+		h.dropSends(f)
+		h.writes3(lead)
+		h.sleep(10 * time.Second)
+		h.note("heal")
+		h.heal()
+		h.sleep(10 * time.Second)
+		if l, ok := h.leader(20*time.Second, nil); ok {
+			h.writes3(l)
+		}
+		h.sleep(3 * time.Second)
+		h.finish()
+	})
+}
