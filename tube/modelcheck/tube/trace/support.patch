+package tube
+
+// TLA+ trace emission for replaying Tube implementation scenarios against Trace.tla.
+//
+// Category A (message passing): one NDJSON file per scenario, one
+// mutex-protected writer shared by every node of the in-process simnet
+// cluster. Reserved slots record the start of a handler or dial and retain
+// its eventual result even when a different goroutine emits first.
+//
+// Envelope of every event line:
+//
+//	{"tag":"trace","ts":<bubble time>,"wall":<real epoch ns>,
+//	 "event":{"name":...,"nid":...,"inc":...,"state":{...},"msg":{...},...}}
+//
+// "ts" is the clock the system runs on (the synctest bubble clock that
+// drives every Tube timer); "wall" is the real wall clock (CLOCK_REALTIME).
+//
+// collect.sh adds this file to the isolated source checkout for each run.
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"os"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	rpc "github.com/glycerine/rpc25519"
+	"golang.org/x/sys/unix"
+)
+
+// ---------------------------------------------------------------------
+// ordered JSON objects (keys keep their insertion order in the output)
+// ---------------------------------------------------------------------
+
+type tkv struct {
+	K string
+	V any
+}
+
+type tobj []tkv
+
+func (o tobj) MarshalJSON() ([]byte, error) {
+	var b bytes.Buffer
+	b.WriteByte('{')
+	for i, kv := range o {
+		if i > 0 {
+			b.WriteByte(',')
+		}
+		kb, err := json.Marshal(kv.K)
+		if err != nil {
+			return nil, err
+		}
+		b.Write(kb)
+		b.WriteByte(':')
+		vb, err := json.Marshal(kv.V)
+		if err != nil {
+			return nil, err
+		}
+		b.Write(vb)
+	}
+	b.WriteByte('}')
+	return b.Bytes(), nil
+}
+
+// PeerKey encoding: {"name":..., "inc":...};
+// an absent PeerID is {"name":"","inc":-1}.
+type tlaKey struct {
+	Name string `json:"name"`
+	Inc  int    `json:"inc"`
+}
+
+var tlaNilKey = tlaKey{Name: "", Inc: -1}
+
+// ---------------------------------------------------------------------
+// the tracer
+// ---------------------------------------------------------------------
+
+type tlaSlot struct {
+	env     tobj // full envelope; nil => dropped slot
+	isEvent bool // env[3] is the "event" object (notes are not events)
+	pending bool // reserved, not yet filled
+}
+
+type tlaDur struct {
+	term int64
+	vote string // PeerID
+}
+
+type tlaTracer struct {
+	mu   sync.Mutex
+	f    *os.File
+	path string
+
+	q []*tlaSlot // not yet written (head may be a pending reservation)
+
+	members  []string        // initial MC member names (first event carries them)
+	initial  map[string]bool // initial members
+	nlines   int             // trace lines written
+	counts   map[string]int  // per event name
+	byID     map[string]tlaKey
+	curID    map[string]string // name -> PeerID of the running process
+	starts   map[string]int    // name -> process starts so far
+	dead     map[string]bool   // PeerID -> crashed incarnation (events suppressed)
+	down     map[string]bool   // name -> currently crashed
+	dialerOf map[string]string // CircuitID -> PeerID of the side that originated it
+	accOf    map[string]string // CircuitID -> PeerID of the accepting side
+	dur      map[string]tlaDur // name -> last durable (term, vote) written by saver.save
+	addrs    map[string][]string
+	linkDown map[[2]string]bool
+}
+
+var tlaT = &tlaTracer{}
+var tlaOnFlag atomic.Bool
+
+func tlaOn() bool { return tlaOnFlag.Load() }
+
+func tlaWall() int64 {
+	var ts unix.Timespec
+	if err := unix.ClockGettime(unix.CLOCK_REALTIME, &ts); err != nil {
+		return 0
+	}
+	return ts.Nano()
+}
+
+func tlaEnvelope(ev tobj) tobj {
+	return tobj{
+		{"tag", "trace"},
+		{"ts", time.Now().UTC().Format(time.RFC3339Nano)},
+		{"wall", tlaWall()},
+		{"event", ev},
+	}
+}
+
+// TlaTraceStart opens path and starts recording. members are the names of
+// the initial MemberConfig (Trace.tla's TraceInitMembers); config is
+// written as a {"tag":"config"} first line (allNodes sets the model server domain).
+func TlaTraceStart(path string, members []string, config map[string]any) error {
+	t := tlaT
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.f != nil {
+		return fmt.Errorf("tla trace already recording to '%v'", t.path)
+	}
+	f, err := os.Create(path)
+	if err != nil {
+		return err
+	}
+	t.f = f
+	t.path = path
+	t.q = nil
+	t.members = append([]string{}, members...)
+	sort.Strings(t.members)
+	t.initial = make(map[string]bool)
+	for _, m := range t.members {
+		t.initial[m] = true
+	}
+	t.nlines = 0
+	t.counts = make(map[string]int)
+	t.byID = make(map[string]tlaKey)
+	t.curID = make(map[string]string)
+	t.starts = make(map[string]int)
+	t.dead = make(map[string]bool)
+	t.down = make(map[string]bool)
+	t.dialerOf = make(map[string]string)
+	t.accOf = make(map[string]string)
+	t.dur = make(map[string]tlaDur)
+	t.addrs = make(map[string][]string)
+	t.linkDown = make(map[[2]string]bool)
+
+	cfg := tobj{{"servers", t.members}}
+	keys := make([]string, 0, len(config))
+	for k := range config {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	for _, k := range keys {
+		cfg = append(cfg, tkv{k, config[k]})
+	}
+	line, err := json.Marshal(tobj{
+		{"tag", "config"},
+		{"ts", time.Now().UTC().Format(time.RFC3339Nano)},
+		{"wall", tlaWall()},
+		{"config", cfg},
+	})
+	if err != nil {
+		return err
+	}
+	f.Write(append(line, '\n'))
+	rpc.SetTLATransportHook(tlaTransportHook)
+	tlaOnFlag.Store(true)
+	return nil
+}
+
+// TlaTraceStop flushes and closes the trace. It discards pending reservations
+// whose outcome was still unobserved when the scenario stopped.
+func TlaTraceStop() (lines int, counts map[string]int) {
+	t := tlaT
+	tlaOnFlag.Store(false)
+	rpc.SetTLATransportHook(nil)
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.f == nil {
+		return
+	}
+	for _, s := range t.q {
+		if s.pending {
+			s.pending = false // outcome unknown: drop it
+			s.env = nil
+		}
+	}
+	t.flushLocked()
+	t.f.Sync()
+	t.f.Close()
+	t.f = nil
+	lines = t.nlines
+	counts = make(map[string]int)
+	for k, v := range t.counts {
+		counts[k] = v
+	}
+	return
+}
+
+func (t *tlaTracer) flushLocked() {
+	for len(t.q) > 0 && !t.q[0].pending {
+		s := t.q[0]
+		t.q = t.q[1:]
+		if s.env == nil || t.f == nil {
+			continue
+		}
+		if s.isEvent {
+			ev := s.env[3].V.(tobj)
+			if t.nlines == 0 {
+				// the first event carries the initial MC members
+				ev = append(ev, tkv{"members", t.members})
+				s.env[3].V = ev
+			}
+			name, _ := ev[0].V.(string)
+			t.counts[name]++
+			t.nlines++
+		}
+		line, err := json.Marshal(s.env)
+		if err != nil {
+			panic(fmt.Sprintf("tla trace marshal: %v", err))
+		}
+		t.f.Write(append(line, '\n'))
+	}
+}
+
+// emitLocked appends ev (an event object) to the queue.
+func (t *tlaTracer) emitLocked(ev tobj) {
+	if t.f == nil {
+		return
+	}
+	t.q = append(t.q, &tlaSlot{env: tlaEnvelope(ev), isEvent: true})
+	t.flushLocked()
+}
+
+// reserveLocked holds a position in the file order for an event whose
+// content is only known later (a dial attempt that takes effect when it
+// starts; a restart whose state is captured when start-up completes).
+func (t *tlaTracer) reserveLocked() *tlaSlot {
+	if t.f == nil {
+		return nil
+	}
+	s := &tlaSlot{pending: true, isEvent: true, env: tlaEnvelope(nil)}
+	t.q = append(t.q, s)
+	return s
+}
+
+func (t *tlaTracer) fillLocked(s *tlaSlot, ev tobj) {
+	if s == nil {
+		return
+	}
+	s.pending = false
+	if ev == nil {
+		s.env = nil
+	} else {
+		s.env[3].V = ev
+	}
+	t.flushLocked()
+}
+
+// keyLocked maps a PeerID to its {name, inc} key.
+func (t *tlaTracer) keyLocked(peerID string) tlaKey {
+	if peerID == "" {
+		return tlaNilKey
+	}
+	if k, ok := t.byID[peerID]; ok {
+		return k
+	}
+	return tlaKey{Name: "unknown:" + peerID, Inc: -1}
+}
+
+func (t *tlaTracer) curIncLocked(name string) int {
+	if id, ok := t.curID[name]; ok {
+		return t.byID[id].Inc
+	}
+	return 0
+}
+
+func tlaAddrName(t *tlaTracer, name, addr string) string {
+	lst := t.addrs[name]
+	for i, a := range lst {
+		if a == addr {
+			return fmt.Sprintf("a%d", i+1)
+		}
+	}
+	t.addrs[name] = append(lst, addr)
+	return fmt.Sprintf("a%d", len(lst)+1)
+}
+
+// ---------------------------------------------------------------------
+// per-node trace state (field TubeNode.tla, added by the patch)
+// ---------------------------------------------------------------------
+
+type tlaPendingEv struct {
+	pre, main *tlaSlot
+	name      string
+	fields    []tkv
+}
+
+type tlaNodeState struct {
+	sentMu      sync.Mutex
+	sent        []tkv // frames sent during the current event-loop step
+	traced      bool  // replica registered with the tracer
+	pend        *tlaPendingEv
+	aeBranch    string   // handleAppendEntries return path
+	restartSlot *tlaSlot // reserved Restart event (non-initial starts)
+	rereg       []string // PeerIDs re-registered by peerJoin during this frame
+}
+
+// tlaRegisterStart is called from Start() as soon as the PeerID is known.
+// It assigns the incarnation (Trace.tla Keys = Server \X 0..MaxInc): the
+// first start of an initial member is incarnation 0 (part of Init); every
+// other start is a Restart with incarnation one more than the spec's inc.
+func (s *TubeNode) tlaRegisterStart() {
+	if !tlaOn() || s.PeerServiceName != TUBE_REPLICA {
+		return
+	}
+	t := tlaT
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.f == nil {
+		return
+	}
+	n := t.starts[s.name]
+	inc := n
+	if !t.initial[s.name] {
+		inc = n + 1
+	}
+	t.starts[s.name] = n + 1
+	t.byID[s.PeerID] = tlaKey{Name: s.name, Inc: inc}
+	t.curID[s.name] = s.PeerID
+	t.down[s.name] = false
+	s.tla.traced = true
+	if inc > 0 {
+		// Restart(n, a): reserve its place now so that dial attempts this
+		// process makes during start-up are ordered after it.
+		s.tla.restartSlot = t.reserveLocked()
+	}
+}
+
+// tlaNoteLoaded records the durable (term, vote) just loaded from disk.
+func (s *TubeNode) tlaNoteLoaded() {
+	if !tlaOn() || !s.tla.traced || s.state == nil {
+		return
+	}
+	t := tlaT
+	t.mu.Lock()
+	t.dur[s.name] = tlaDur{term: s.state.CurrentTerm, vote: s.state.VotedFor}
+	t.mu.Unlock()
+}
+
+// tlaNoteSaved is called by raftStatePersistor.save after the state file
+// was published (persistor.go): the shadow of the durable term/vote.
+func tlaNoteSaved(state *RaftState) {
+	if !tlaOn() || state == nil || state.PeerName == "" {
+		return
+	}
+	t := tlaT
+	t.mu.Lock()
+	t.dur[state.PeerName] = tlaDur{term: state.CurrentTerm, vote: state.VotedFor}
+	t.mu.Unlock()
+}
+
+// tlaStartupDone fills the reserved Restart event just before the main loop.
+func (s *TubeNode) tlaStartupDone() {
+	if !tlaOn() || !s.tla.traced {
+		return
+	}
+	slot := s.tla.restartSlot
+	s.tla.restartSlot = nil
+	if slot == nil {
+		return
+	}
+	raw := s.tlaRawSnapshot()
+	addr := ""
+	if s.MyPeer != nil {
+		addr = s.MyPeer.BaseServerAddr
+	}
+	if addr == "" && s.rpcServerAddr != nil {
+		addr = s.rpcServerAddr.String()
+	}
+	t := tlaT
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	key, ok := t.byID[s.PeerID]
+	if !ok || t.dead[s.PeerID] {
+		t.fillLocked(slot, nil)
+		return
+	}
+	ev := tobj{
+		{"name", "Restart"},
+		{"nid", s.name},
+		{"inc", key.Inc},
+		{"addr", tlaAddrName(t, s.name, addr)},
+		{"state", t.renderStateLocked(s.name, raw)},
+		{"info", t.renderInfoLocked(raw)},
+	}
+	t.fillLocked(slot, ev)
+}
+
+// ---------------------------------------------------------------------
+// state snapshot (section 1.2), read on the node's event-loop goroutine
+// ---------------------------------------------------------------------
+
+type tlaRawPeer struct {
+	id       string
+	mi, lcri int64
+}
+
+type tlaRawState struct {
+	role                                       string
+	term                                       int64
+	votedFor, leader                           string
+	ci, ciTerm, la, lli, llt, compact          int64
+	restartHoldoff, deferred, deferredElection bool
+	cfgTerm, cfgVer, cfgCI                     int64
+	cfgCommitted                               bool
+	members, shadows                           []string
+	parUnknown, parActive                      bool
+	cktall, cktReplica                         []string
+	pendingNames, circuitNames                 []string
+	peers                                      []tlaRawPeer
+}
+
+func tlaRole(r RaftRole) string {
+	switch r {
+	case FOLLOWER:
+		return "FOLLOWER"
+	case CANDIDATE:
+		return "CANDIDATE"
+	case LEADER:
+		return "LEADER"
+	case CLIENT:
+		return "CLIENT"
+	}
+	return fmt.Sprintf("ROLE_%d", int(r))
+}
+
+func tlaNames(mc *MemberConfig) []string {
+	r := make([]string, 0)
+	if mc == nil || mc.PeerNames == nil {
+		return r
+	}
+	for name := range mc.PeerNames.All() {
+		r = append(r, name)
+	}
+	sort.Strings(r)
+	return r
+}
+
+func (s *TubeNode) tlaRawSnapshot() *tlaRawState {
+	r := &tlaRawState{role: tlaRole(s.role), leader: s.leaderID}
+	if s.state != nil {
+		r.term = s.state.CurrentTerm
+		r.votedFor = s.state.VotedFor
+		r.ci = s.state.CommitIndex
+		r.ciTerm = s.state.CommitIndexEntryTerm
+		r.restartHoldoff = time.Now().Before(s.restartVoteDeadline)
+		r.deferred = s.deferredCampaignCh != nil
+		r.deferredElection = s.deferredElection
+		r.la = s.state.LastApplied
+		r.compact = s.state.CompactionDiscardedLast.Index
+		if mc := s.state.MC; mc != nil {
+			r.cfgTerm = mc.ConfigTerm
+			r.cfgVer = mc.ConfigVersion
+			r.cfgCI = mc.CommitIndex
+			r.cfgCommitted = mc.IsCommitted
+		}
+		r.members = tlaNames(s.state.MC)
+		r.shadows = tlaNames(s.state.ShadowReplicas)
+	} else {
+		r.members = make([]string, 0)
+		r.shadows = make([]string, 0)
+	}
+	if s.wal != nil {
+		r.lli, r.llt = s.wal.LastLogIndexAndTerm()
+		if r.lli < 0 {
+			r.lli = 0
+		}
+		if r.lli == 0 {
+			r.llt = 0
+		}
+	}
+	if s.par != nil {
+		r.parUnknown = s.par.unknown
+		r.parActive = s.par.active
+	}
+	r.cktall = make([]string, 0, len(s.cktall))
+	for id := range s.cktall {
+		r.cktall = append(r.cktall, id)
+	}
+	r.cktReplica = make([]string, 0, len(s.cktReplica))
+	for id := range s.cktReplica {
+		r.cktReplica = append(r.cktReplica, id)
+	}
+	r.pendingNames = make([]string, 0)
+	r.circuitNames = make([]string, 0)
+	for name, cktP := range s.cktAllByName {
+		if cktP == nil {
+			continue
+		}
+		if cktP.ckt == nil {
+			r.pendingNames = append(r.pendingNames, name)
+		} else {
+			r.circuitNames = append(r.circuitNames, name)
+		}
+	}
+	sort.Strings(r.pendingNames)
+	sort.Strings(r.circuitNames)
+	for id, info := range s.peers {
+		if info == nil {
+			continue
+		}
+		r.peers = append(r.peers, tlaRawPeer{id: id, mi: info.MatchIndex, lcri: info.LargestCommonRaftIndex})
+	}
+	return r
+}
+
+func tlaSortKeys(ks []tlaKey) []tlaKey {
+	sort.Slice(ks, func(i, j int) bool {
+		if ks[i].Name != ks[j].Name {
+			return ks[i].Name < ks[j].Name
+		}
+		return ks[i].Inc < ks[j].Inc
+	})
+	return ks
+}
+
+func (t *tlaTracer) renderStateLocked(name string, r *tlaRawState) tobj {
+	cktall := make([]tlaKey, 0, len(r.cktall))
+	for _, id := range r.cktall {
+		cktall = append(cktall, t.keyLocked(id))
+	}
+	cktReplica := make([]tlaKey, 0, len(r.cktReplica))
+	for _, id := range r.cktReplica {
+		cktReplica = append(cktReplica, t.keyLocked(id))
+	}
+	st := tobj{
+		{"role", r.role},
+		{"term", r.term},
+		{"votedFor", t.keyLocked(r.votedFor)},
+		{"leader", t.keyLocked(r.leader)},
+		{"commitIndex", r.ci},
+		{"commitTerm", r.ciTerm},
+		{"restartHoldoff", r.restartHoldoff},
+		{"deferred", r.deferred},
+		{"deferredElection", r.deferredElection},
+		{"lastApplied", r.la},
+		{"lli", r.lli},
+		{"llt", r.llt},
+		{"compactIndex", r.compact},
+		{"cfgTerm", r.cfgTerm},
+		{"cfgVer", r.cfgVer},
+		{"members", r.members},
+		{"parUnknown", r.parUnknown},
+		{"cktall", tlaSortKeys(cktall)},
+		{"pendingNames", r.pendingNames},
+		{"circuitNames", r.circuitNames},
+		{"cktReplica", tlaSortKeys(cktReplica)},
+	}
+	if d, ok := t.dur[name]; ok {
+		st = append(st, tkv{"dTerm", d.term}, tkv{"dVote", t.keyLocked(d.vote)})
+	}
+	return st
+}
+
+// renderInfoLocked records membership, recovery and peer diagnostics (kept out
+// of "state", whose every field ValidatePostState checks).  Candidate
+// checks: cfgCommitted ~ config[n].com, cfgCI ~ config[n].ci,
+// shadows ~ shadows[n], peers ~ peers[n] (mi, lcri).
+func (t *tlaTracer) renderInfoLocked(r *tlaRawState) tobj {
+	peers := make([]tobj, 0, len(r.peers))
+	sort.Slice(r.peers, func(i, j int) bool { return r.peers[i].id < r.peers[j].id })
+	for _, p := range r.peers {
+		k := t.keyLocked(p.id)
+		peers = append(peers, tobj{{"name", k.Name}, {"inc", k.Inc}, {"mi", p.mi}, {"lcri", p.lcri}})
+	}
+	return tobj{
+		{"parActive", r.parActive},
+		{"cfgCommitted", r.cfgCommitted},
+		{"cfgCI", r.cfgCI},
+		{"shadows", r.shadows},
+		{"peers", peers},
+	}
+}
+
+// ---------------------------------------------------------------------
+// node events (event-loop goroutine)
+// ---------------------------------------------------------------------
+
+// tlaEmit writes a node event with the post-step state of s.
+func (s *TubeNode) tlaEmit(name string, fields ...tkv) {
+	if !tlaOn() || !s.tla.traced {
+		return
+	}
+	raw := s.tlaRawSnapshot()
+	t := tlaT
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	key, ok := t.byID[s.PeerID]
+	if !ok || t.dead[s.PeerID] {
+		return
+	}
+	ev := tobj{{"name", name}, {"nid", s.name}, {"inc", key.Inc}}
+	ev = append(ev, tkv{"state", t.renderStateLocked(s.name, raw)}, tkv{"info", t.renderInfoLocked(raw)})
+	for _, f := range fields {
+		ev = append(ev, t.resolveLocked(f))
+	}
+	s.tla.sentMu.Lock()
+	sent := s.tla.sent
+	s.tla.sent = nil
+	s.tla.sentMu.Unlock()
+	if len(sent) > 0 {
+		lst := make([]tobj, 0, len(sent))
+		for _, x := range sent {
+			lst = append(lst, t.resolveLocked(x).V.(tobj))
+		}
+		ev = append(ev, tkv{"sent", lst})
+	}
+	if len(s.tla.rereg) > 0 {
+		keys := make([]tlaKey, 0, len(s.tla.rereg))
+		for _, id := range s.tla.rereg {
+			keys = append(keys, t.keyLocked(id))
+		}
+		ev = append(ev, tkv{"peerJoinReRegistered", keys})
+		s.tla.rereg = nil
+	}
+	if p := s.tla.pend; p != nil && p.main != nil {
+		if name == "Compact" && p.pre != nil {
+			t.fillLocked(p.pre, ev)
+			p.pre = nil
+			return
+		}
+		if name == p.name {
+			t.fillLocked(p.pre, nil)
+			t.fillLocked(p.main, ev)
+			return
+		}
+	}
+	t.emitLocked(ev)
+}
+
+// tlaPeerRef defers a PeerID -> key conversion to emission time.
+type tlaPeerRef string
+
+// tlaPeerRec renders as Trace.tla's peerRec {"name","inc","mi","lcri"}.
+type tlaPeerRec struct {
+	id       string
+	mi, lcri int64
+}
+
+// tlaMsgObj builds a message object; values of type tlaPeerRef are mapped.
+type tlaMsgObj tobj
+
+func (t *tlaTracer) resolveLocked(f tkv) tkv {
+	switch v := f.V.(type) {
+	case tlaPeerRef:
+		return tkv{f.K, t.keyLocked(string(v))}
+	case tlaPeerRec:
+		k := t.keyLocked(v.id)
+		return tkv{f.K, tobj{{"name", k.Name}, {"inc", k.Inc}, {"mi", v.mi}, {"lcri", v.lcri}}}
+	case tlaMsgObj:
+		o := make(tobj, 0, len(v))
+		for _, x := range v {
+			o = append(o, t.resolveLocked(x))
+		}
+		return tkv{f.K, o}
+	}
+	return f
+}
+
+// tlaPendSet records the event of the current step; it is written by
+// tlaPendFlush, or earlier by becomeLeader (split becomeLeader, section 2.4).
+func (s *TubeNode) tlaPendSet(name string, fields ...tkv) {
+	if !tlaOn() || !s.tla.traced {
+		return
+	}
+	p := &tlaPendingEv{name: name, fields: fields}
+	// The AE handler can pulse a watchdog, whose work may run before the
+	// handler returns. Reserve the action and its optional nested compaction.
+	if name == "HandleAppendEntries" {
+		tlaT.mu.Lock()
+		p.pre, p.main = tlaT.reserveLocked(), tlaT.reserveLocked()
+		tlaT.mu.Unlock()
+	}
+	s.tla.pend = p
+}
+
+// tlaPendFlush writes the pending event (if becomeLeader has not).
+func (s *TubeNode) tlaPendFlush(extra ...tkv) {
+	if s.tla.pend == nil {
+		return
+	}
+	p := s.tla.pend
+	s.tlaEmit(p.name, append(p.fields, extra...)...)
+	s.tla.pend = nil
+}
+
+// tlaBecomeLeaderBeforeSave: becomeLeader is split into the step that ends
+// with the noop0 broadcast (the triggering HandleVote / PreVotePhase2Timeout
+// event) and BecomeLeaderSave (the deferred saver.save).
+func (s *TubeNode) tlaBecomeLeaderBeforeSave() {
+	s.tlaPendFlush(tkv{"becameLeader", true})
+}
+
+// frame message objects (section 1.4)
+
+func tlaMsgRV(frag *rpc.Fragment, rv *RequestVote) tkv {
+	return tkv{"msg", tlaMsgObj{{"cid", frag.CircuitID}, {"from", tlaPeerRef(frag.FromPeerID)}, {"term", rv.CandidatesTerm}}}
+}
+
+func tlaMsgVote(frag *rpc.Fragment, v *Vote) tkv {
+	return tkv{"msg", tlaMsgObj{{"cid", frag.CircuitID}, {"from", tlaPeerRef(frag.FromPeerID)}, {"term", v.CandidatesTerm},
+		{"granted", v.VoteGranted}}}
+}
+
+func tlaMsgAE(frag *rpc.Fragment, ae *AppendEntries) tkv {
+	return tkv{"msg", tlaMsgObj{{"cid", frag.CircuitID}, {"from", tlaPeerRef(frag.FromPeerID)}, {"term", ae.LeaderTerm},
+		{"prev", ae.PrevLogIndex}, {"nents", len(ae.Entries)}, {"commit", ae.LeaderCommitIndex}}}
+}
+
+func tlaMsgAEA(frag *rpc.Fragment, a *AppendEntriesAck) tkv {
+	return tkv{"msg", tlaMsgObj{{"cid", frag.CircuitID}, {"from", tlaPeerRef(frag.FromPeerID)}, {"term", a.Term},
+		{"rejected", a.Rejected}, {"lcri", a.LargestCommonRaftIndex}, {"last", a.PeerLogLastIndex}}}
+}
+
+func tlaMsgSnap(frag *rpc.Fragment) tkv {
+	return tkv{"msg", tlaMsgObj{{"cid", frag.CircuitID}, {"from", tlaPeerRef(frag.FromPeerID)}, {"part", frag.FragPart}}}
+}
+
+func tlaMsgFrom(frag *rpc.Fragment) tkv {
+	return tkv{"msg", tlaMsgObj{{"cid", frag.CircuitID}, {"from", tlaPeerRef(frag.FromPeerID)}}}
+}
+
+// tlaAckPeerRec: leader's RaftNodeInfo for the acker after the step.
+func (s *TubeNode) tlaAckPeerRec(fromPeerID string) []tkv {
+	info, ok := s.peers[fromPeerID]
+	if !ok || info == nil {
+		return nil
+	}
+	return []tkv{{"peerRec", tlaPeerRec{id: fromPeerID, mi: info.MatchIndex, lcri: info.LargestCommonRaftIndex}}}
+}
+
+// circuit identity for HandleNewCircuit / HandlePeerLeft: (nid, peer, dialer)
+func (s *TubeNode) tlaCktFields(ckt *rpc.Circuit) []tkv {
+	if ckt == nil {
+		return nil
+	}
+	t := tlaT
+	t.mu.Lock()
+	d, a := t.dialerOf[ckt.CircuitID], t.accOf[ckt.CircuitID]
+	t.mu.Unlock()
+	dialer := d == ckt.LocalPeerID || (d == "" && a != "" && a != ckt.LocalPeerID)
+	return []tkv{
+		{"peer", tlaPeerRef(ckt.RemotePeerID)},
+		{"dialer", dialer},
+		{"cid", ckt.CircuitID},
+	}
+}
+
+// tlaNoteReReg: peerJoin re-registered a circuit outside handleNewCircuit.
+func (s *TubeNode) tlaNoteReReg(peerID string) {
+	if !tlaOn() || !s.tla.traced {
+		return
+	}
+	s.tla.rereg = append(s.tla.rereg, peerID)
+}
+
+// ---------------------------------------------------------------------
+// events from other goroutines (no state snapshot)
+// ---------------------------------------------------------------------
+
+// tlaDialBegin reserves the DialAttempt slot of watchdog reconnect: the
+// attempt takes effect when it starts, before the remote can register the
+// new circuit.
+func (s *TubeNode) tlaDialBegin() *tlaSlot {
+	if !tlaOn() || !s.tla.traced {
+		return nil
+	}
+	t := tlaT
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.dead[s.PeerID] {
+		return nil
+	}
+	return t.reserveLocked()
+}
+
+// tlaDialEnd fills the reservation with the attempt's outcome.
+func (s *TubeNode) tlaDialEnd(slot *tlaSlot, target string, ok bool, why string, circuitIDs ...string) {
+	if !tlaOn() || !s.tla.traced {
+		return
+	}
+	t := tlaT
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	key, known := t.byID[s.PeerID]
+	if !known || t.dead[s.PeerID] {
+		if slot != nil {
+			t.fillLocked(slot, nil)
+		}
+		return
+	}
+	ev := tobj{{"name", "DialAttempt"}, {"nid", s.name}, {"inc", key.Inc},
+		{"target", target}, {"ok", ok}, {"serviceUnavailable", strings.Contains(why, "no local peerServiceName")}}
+	if len(circuitIDs) != 0 && circuitIDs[0] != "" {
+		ev = append(ev, tkv{"cid", circuitIDs[0]})
+	}
+	if why != "" {
+		ev = append(ev, tkv{"why", why})
+	}
+	if slot == nil {
+		t.emitLocked(ev)
+		return
+	}
+	t.fillLocked(slot, ev)
+}
+
+// tlaPeerError: the Tube per-circuit reader received a CallPeerError
+// fragment.
+func (s *TubeNode) tlaPeerError(ckt *rpc.Circuit, fragerr *rpc.Fragment) {
+	if !tlaOn() || !s.tla.traced {
+		return
+	}
+	t := tlaT
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	key, ok := t.byID[s.PeerID]
+	if !ok || t.dead[s.PeerID] {
+		return
+	}
+	from := ""
+	if fragerr != nil {
+		from = fragerr.FromPeerID
+	}
+	if from == "" && ckt != nil {
+		from = ckt.RemotePeerID
+	}
+	ev := tobj{{"name", "HandlePeerError"}, {"nid", s.name}, {"inc", key.Inc},
+		{"msg", tobj{{"from", t.keyLocked(from)}}}}
+	if ckt != nil {
+		ev = append(ev, tkv{"cid", ckt.CircuitID})
+	}
+	if fragerr != nil && fragerr.Err != "" {
+		ev = append(ev, tkv{"err", fragerr.Err})
+	}
+	t.emitLocked(ev)
+}
+
+// tlaNodeOfSimName maps simnet endpoint names to node names:
+// "srv_node_0", "simnet://srv_node_0", "auto-cli-from-srv_node_0-to-..."
+func tlaNodeOfSimName(x string) string {
+	x = strings.TrimPrefix(x, "simnet://")
+	if i := strings.Index(x, "://"); i >= 0 {
+		x = x[i+3:]
+	}
+	if strings.HasPrefix(x, "auto-cli-from-") {
+		x = x[len("auto-cli-from-"):]
+		if i := strings.Index(x, "-to-"); i >= 0 {
+			x = x[:i]
+		}
+	}
+	if i := strings.Index(x, "/"); i >= 0 {
+		x = x[:i]
+	}
+	return strings.TrimPrefix(x, "srv_")
+}
+
+// tlaTransportHook receives rpc25519 transport events.
+func tlaTransportHook(e rpc.TLATransportEvent) {
+	t := tlaT
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.f == nil {
+		return
+	}
+	switch e.Name {
+	case "NewCircuit":
+		if e.CallID != "" {
+			if e.IsDialer {
+				t.dialerOf[e.CallID] = e.LocalPeerID
+			} else {
+				t.accOf[e.CallID] = e.LocalPeerID
+			}
+		}
+		return
+
+	case "HandleEndCircuit", "DropUnroutable":
+		key, ok := t.byID[e.LocalPeerID]
+		if !ok || t.dead[e.LocalPeerID] {
+			return
+		}
+		ev := tobj{{"name", e.Name}, {"nid", key.Name}, {"inc", key.Inc},
+			{"msg", tobj{{"from", t.keyLocked(e.FromPeerID)}, {"type", e.MsgType}}},
+			{"cid", e.CallID}}
+		if e.ToPeerID != "" {
+			ev = append(ev, tkv{"to", t.keyLocked(e.ToPeerID)})
+		}
+		t.emitLocked(ev)
+
+	case "DropStaleTarget", "ConnAbort":
+		name := tlaNodeOfSimName(e.ServerName)
+		id, ok := t.curID[name]
+		if !ok || t.down[name] || t.dead[id] {
+			return
+		}
+		key := t.byID[id]
+		ev := tobj{{"name", e.Name}, {"nid", key.Name}, {"inc", key.Inc}}
+		if e.Name == "DropStaleTarget" {
+			ev = append(ev, tkv{"msg", tobj{{"from", t.keyLocked(e.FromPeerID)}, {"type", e.MsgType}}},
+				tkv{"to", t.keyLocked(e.ToPeerID)}, tkv{"cid", e.CallID})
+		}
+		rem := tlaNodeOfSimName(e.RemoteName)
+		ev = append(ev, tkv{"peer", tlaKey{Name: rem, Inc: t.curIncLocked(rem)}},
+			tkv{"conn", e.RemoteName})
+		t.emitLocked(ev)
+	}
+}
+
+// ---------------------------------------------------------------------
+// harness (environment) events, called by the test scenarios
+// ---------------------------------------------------------------------
+
+// TlaCrash records Crash(n) and suppresses every later event of the
+// crashed incarnation. Call it just before cutting the node off.
+// detail fields are informational (e.g. "kind": "process"/"host", or the
+// disk fault the harness applies to the dead node's files).
+func TlaCrash(name string, detail map[string]any) {
+	t := tlaT
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.f == nil {
+		return
+	}
+	id := t.curID[name]
+	key := t.byID[id]
+	ev := tobj{{"name", "Crash"}, {"nid", name}, {"inc", key.Inc}}
+	keys := make([]string, 0, len(detail))
+	for k := range detail {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	for _, k := range keys {
+		ev = append(ev, tkv{k, detail[k]})
+	}
+	t.emitLocked(ev)
+	t.dead[id] = true
+	t.down[name] = true
+}
+
+// TlaLink records LinkDown(from, to) / LinkUp(from, to) (directional).
+func TlaLink(up bool, from, to string) {
+	t := tlaT
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.f == nil {
+		return
+	}
+	k := [2]string{from, to}
+	if up == !t.linkDown[k] {
+		return // already in that state
+	}
+	t.linkDown[k] = !up
+	name := "LinkDown"
+	if up {
+		name = "LinkUp"
+	}
+	t.emitLocked(tobj{{"name", name}, {"nid", from}, {"inc", t.curIncLocked(from)},
+		{"from", from}, {"to", to}})
+}
+
+// TlaLinksDown returns the directional links currently down.
+func TlaLinksDown() (r [][2]string) {
+	t := tlaT
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	for k, d := range t.linkDown {
+		if d {
+			r = append(r, k)
+		}
+	}
+	sort.Slice(r, func(i, j int) bool {
+		if r[i][0] != r[j][0] {
+			return r[i][0] < r[j][0]
+		}
+		return r[i][1] < r[j][1]
+	})
+	return
+}
+
+// TlaNote writes a free-form harness annotation line ({"tag":"note"}),
+// ignored by Trace.tla; it marks scenario phases for human readers.
+func TlaNote(msg string) {
+	t := tlaT
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.f == nil {
+		return
+	}
+	t.q = append(t.q, &tlaSlot{env: tobj{
+		{"tag", "note"},
+		{"ts", time.Now().UTC().Format(time.RFC3339Nano)},
+		{"wall", tlaWall()},
+		{"note", msg},
+	}})
+	t.flushLocked()
+}
+
+// tlaEmitChangeMembership: ClientChangeMembership(n, op, x) at the leader
+// after changeMembership returns.
+func (s *TubeNode) tlaEmitChangeMembership(tkt *Ticket) {
+	if !tlaOn() || !s.tla.traced || tkt == nil {
+		return
+	}
+	op, target := "add", tkt.AddPeerName
+	if tkt.AddPeerName == "" {
+		op, target = "remove", tkt.RemovePeerName
+	}
+	fields := []tkv{{"op", op}, {"target", target}}
+	if tkt.Err != nil {
+		fields = append(fields, tkv{"err", tkt.Err.Error()})
+	}
+	s.tlaEmit("ClientChangeMembership", fields...)
+}
+
+// ---------------------------------------------------------------------
+// frames sent by a step (informational "sent" list on the next event)
+// ---------------------------------------------------------------------
+
+// tlaStepBegin is called at the top of every event-loop select: frames
+// recorded by an earlier step that emitted no event are discarded.
+func (s *TubeNode) tlaStepBegin() {
+	if !tlaOn() || !s.tla.traced {
+		return
+	}
+	s.tla.sentMu.Lock()
+	s.tla.sent = nil
+	s.tla.sentMu.Unlock()
+	s.tla.rereg = nil
+}
+
+// tlaSendRec captures what a SendOneWay is about to put on a circuit
+// (read before the send: the fragment may be recycled afterwards).
+func (s *TubeNode) tlaSendRec(ckt *rpc.Circuit, frag *rpc.Fragment) *tkv {
+	if !tlaOn() || !s.tla.traced || ckt == nil || frag == nil {
+		return nil
+	}
+	o := tlaMsgObj{}
+	switch frag.FragOp {
+	case AppendEntriesMsg:
+		ae := &AppendEntries{}
+		if _, err := ae.UnmarshalMsg(frag.Payload); err == nil {
+			o = append(o, tkv{"op", "AE"}, tkv{"term", ae.LeaderTerm}, tkv{"prev", ae.PrevLogIndex},
+				tkv{"nents", len(ae.Entries)}, tkv{"commit", ae.LeaderCommitIndex})
+		} else {
+			o = append(o, tkv{"op", "AE"})
+		}
+	case AppendEntriesAckMsg:
+		a := &AppendEntriesAck{}
+		if _, err := a.UnmarshalMsg(frag.Payload); err == nil {
+			o = append(o, tkv{"op", "AEA"}, tkv{"term", a.Term}, tkv{"rejected", a.Rejected},
+				tkv{"lcri", a.LargestCommonRaftIndex}, tkv{"last", a.PeerLogLastIndex})
+		} else {
+			o = append(o, tkv{"op", "AEA"})
+		}
+	case RequestVoteMsg, RequestPreVoteMsg:
+		op := "RV"
+		if frag.FragOp == RequestPreVoteMsg {
+			op = "RPV"
+		}
+		rv := &RequestVote{}
+		if _, err := rv.UnmarshalMsg(frag.Payload); err == nil {
+			o = append(o, tkv{"op", op}, tkv{"term", rv.CandidatesTerm})
+		} else {
+			o = append(o, tkv{"op", op})
+		}
+	case VoteMsg, PreVoteMsg:
+		op := "V"
+		if frag.FragOp == PreVoteMsg {
+			op = "PV"
+		}
+		v := &Vote{}
+		if _, err := v.UnmarshalMsg(frag.Payload); err == nil {
+			o = append(o, tkv{"op", op}, tkv{"term", v.CandidatesTerm}, tkv{"granted", v.VoteGranted})
+		} else {
+			o = append(o, tkv{"op", op})
+		}
+	case StateSnapshotEnclosed:
+		o = append(o, tkv{"op", "SNAP"}, tkv{"part", frag.FragPart})
+	case RequestStateSnapshot:
+		o = append(o, tkv{"op", "RSS"})
+	default:
+		sub := frag.FragSubject
+		if sub == "" {
+			sub = fmt.Sprintf("FragOp%d", frag.FragOp)
+		}
+		o = append(o, tkv{"op", sub})
+	}
+	o = append(o, tkv{"to", tlaPeerRef(ckt.RemotePeerID)}, tkv{"cid", ckt.CircuitID})
+	return &tkv{"sent", o}
+}
+
+// tlaNoteSend appends the captured frame, with the send outcome.
+func (s *TubeNode) tlaNoteSend(rec *tkv, err error) {
+	if rec == nil {
+		return
+	}
+	o := rec.V.(tlaMsgObj)
+	if err != nil {
+		o = append(o, tkv{"err", err.Error()})
+	}
+	s.tla.sentMu.Lock()
+	s.tla.sent = append(s.tla.sent, tkv{"sent", o})
+	s.tla.sentMu.Unlock()
+}
