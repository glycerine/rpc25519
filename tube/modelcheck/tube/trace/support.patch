+// Membership change: a fourth replica (empty MC) is started and added by
+// the leader (ClientChangeMembership add), then a follower is removed.
+func TestTLATrace_membership_add_remove(t *testing.T) {
+	onlyBubbled(t, func(t *testing.T) {
+		h := newTlaHarness(t, "membership_add_remove", 3, 4, nil)
+		h.startInitial()
+		lead, ok := h.leader(30*time.Second, nil)
+		if !ok {
+			h.finish()
+			t.Fatal("no leader elected")
+		}
+		h.sleep(time.Second)
+		h.writes3(lead)
+
+		h.note("start joiner node_3")
+		h.startNode(3)
+		h.sleep(2 * time.Second)
+		leader := h.c.Nodes[lead]
+		joiner := h.c.Nodes[3]
+		ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+		insp, _, err := leader.AddPeerIDToCluster(ctx, false, false, joiner.name, joiner.PeerID,
+			TUBE_REPLICA, joiner.BaseServerHostPort(), leader.URL, 20*time.Second)
+		cancel()
+		if insp != nil && insp.State != nil && insp.State.KVstore != nil {
+			insp.State.KVstore.Close()
+		}
+		h.note("add node_3: err=%v", err)
+		h.sleep(5 * time.Second)
+		if l, ok := h.leader(20*time.Second, nil); ok {
+			lead = l
+			h.writes3(lead)
+		}
+
+		// remove a follower that is not the leader
+		victim := (lead + 1) % 3
+		v := h.c.Nodes[victim]
+		leader = h.c.Nodes[lead]
+		ctx, cancel = context.WithTimeout(context.Background(), 20*time.Second)
+		insp, _, err = leader.RemovePeerIDFromCluster(ctx, false, false, v.name, v.PeerID,
+			TUBE_REPLICA, v.BaseServerHostPort(), leader.URL, 20*time.Second)
+		cancel()
+		if insp != nil && insp.State != nil && insp.State.KVstore != nil {
+			insp.State.KVstore.Close()
+		}
+		h.note("remove %v: err=%v", v.name, err)
+		h.sleep(5 * time.Second)
+		if l, ok := h.leader(20*time.Second, nil); ok {
+			h.writes3(l)
+		}
+		h.sleep(5 * time.Second)
+		h.finish()
+	})
+}
