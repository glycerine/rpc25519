#lang ivy1.7

include order

# ivy_check said OK.
# Single-key Hermes protocol model with O3 broadcast-ACK completion,
# including RMW O3 completion guarded by the RMW conflict rule.
#
# Hermes safety composes per key, so this model verifies one key and proves
# read-state agreement, not a full history linearizability theorem. It includes normal writes, RMWs,
# invalidations, acknowledgements, validations, write replay after membership
# removal, and the "invalid_write" / overwritten local update state.

module total_order(r) = {
    axiom r(X,X)
    axiom r(X,Y) & r(Y,Z) -> r(X,Z)
    axiom r(X,Y) & r(Y,X) -> X = Y
    axiom r(X,Y) | r(Y,X)
}

type ltask = {ready_finish, o3_finish}

isolate hermes_protocol = {

    type node
    type ts
    type value
    type epoch
    instance version : unbounded_sequence

    type hstate = {hs_valid, hs_invalid, hs_invalid_write, hs_write, hs_replay}

    action local_write(n:node, t:ts, v:value)
    action local_rmw(n:node, t:ts, v:value)
    action receive_write_inv(n:node, s:node, t:ts, v:value)
    action receive_rmw_inv(n:node, s:node, t:ts, v:value)
    action receive_ack(n:node, a:node, t:ts)
    action complete_current(n:node)
    action complete_overwritten(n:node)
    action complete_ready(n:node)
    action o3_observe_quorum(n:node, c:node, t:ts)
    action o3_complete(n:node, c:node, t:ts)
    action mark_ready(n:node, e:epoch)
    action receive_validate(n:node, t:ts)
    action replay_after_failure(n:node)
    action fail(n:node)

    specification {

        relation le(X:ts,Y:ts)
        instantiate total_order(le)

        relation lt(X:ts,Y:ts) = le(X,Y) & X ~= Y

        individual ready_task:ltask
        individual o3_task:ltask
        individual init_ts:ts
        individual init_value:value
        individual init_epoch:epoch
        axiom le(init_ts,T)

        # Current per-node key metadata.
        individual state(N:node):hstate
        individual cur_ts(N:node):ts
        individual cur_value(N:node):value
        relation cur_rmw(N:node)
        individual last_writer(N:node):node
        relation writer_live(N:node)
        relation live(N:node)

        # Local pending operation metadata. A node may have an overwritten
        # pending operation while its current key timestamp is already newer.
        relation pending(N:node)
        individual pending_ts(N:node):ts
        relation pending_rmw(N:node)
        relation acked(C:node,A:node)
        relation ready(N:node)
        individual ready_epoch(N:node):epoch
        relation seen_epoch(E:epoch)
        relation epoch_done(E:epoch)
        relation ready_epoch_active(E:epoch)

        # One-slot client request buffers. These model requests arriving at a
        # live server while the local key replica is not yet able to start the
        # low-level protocol transition. makes the randomized testing more efficient.
        relation client_write_pending(N:node)
        individual client_write_value(N:node):value
        relation client_rmw_pending(N:node)
        individual client_rmw_value(N:node):value
        relation local_key_known(N:node) =
            live(N) & (state(N) = hs_valid | state(N) = hs_invalid | pending(N))
        # Timestamp metadata. `parent(T,B)` means update timestamp T was
        # generated from base timestamp B.
        relation seen_ts(T:ts)
        relation parent(T:ts,B:ts)
        relation same_parent(T:ts,U:ts)
        individual parent_ts(T:ts):ts
        relation ts_version(T:ts,V:version)
        relation same_version(T:ts,U:ts)
        relation next_version(T:ts,U:ts)
        relation write_then_write_order_ok(N:node,M:node) =
            same_version(cur_ts(N),cur_ts(M)) | lt(cur_ts(N),cur_ts(M))
        relation rmw_then_write_order_ok(N:node,M:node) =
            same_version(cur_ts(N),cur_ts(M)) | lt(cur_ts(N),cur_ts(M)) |
            next_version(cur_ts(N),cur_ts(M))
        relation rmw_then_rmw_order_ok(N:node,M:node) =
            same_version(cur_ts(N),cur_ts(M)) | lt(cur_ts(N),cur_ts(M))
        relation can_start_client_write(N:node,T:ts) =
            client_write_pending(N) & live(N) & ~pending(N) &
            (state(N) = hs_valid | state(N) = hs_invalid) &
            lt(cur_ts(N),T) & ~seen_ts(T)
        relation can_start_client_rmw(N:node,T:ts) =
            client_rmw_pending(N) & live(N) & ~pending(N) &
            state(N) = hs_valid &
            lt(cur_ts(N),T) & ~seen_ts(T)
        relation ts_value(T:ts,V:value)
        relation ts_rmw(T:ts)
        relation rmw_conflict(T:ts)
        relation write_conflict(T:ts)

        # Persistent network buffers. Messages are never removed, matching the
        # TLA model's duplicate/reordering tolerance.
        relation inv_write(S:node,T:ts,V:value)
        relation inv_rmw(S:node,T:ts,V:value)
        relation ack_msg(A:node,C:node,T:ts)
        relation val_msg(T:ts)
        relation o3_quorum(N:node,C:node,T:ts)

        relation complete_try(N:node)
        relation o3_try(N:node,C:node,T:ts)

        # A timestamp is externally completed once its coordinator/replayer has
        # gathered ACKs from all live members in the current membership.
        relation completed(T:ts)

        after init {
            ready_task := ready_finish;
            o3_task := o3_finish;
            live(N) := true;
            state(N) := hs_valid;
            cur_ts(N) := init_ts;
            cur_value(N) := init_value;
            cur_rmw(N) := false;
            last_writer(N) := N;
            writer_live(N) := true;

            pending(N) := false;
            pending_ts(N) := init_ts;
            pending_rmw(N) := false;
            acked(C,A) := false;
            ready(N) := false;
            ready_epoch(N) := init_epoch;
            seen_epoch(E) := E = init_epoch;
            epoch_done(E) := E = init_epoch;
            ready_epoch_active(E) := false;
            client_write_pending(N) := false;
            client_write_value(N) := init_value;
            client_rmw_pending(N) := false;
            client_rmw_value(N) := init_value;

            seen_ts(T) := T = init_ts;
            parent(T,B) := false;
            same_parent(T,U) := false;
            parent_ts(T) := init_ts;
            ts_version(T,V) := T = init_ts & V = 0;
            same_version(T,U) := false;
            same_version(init_ts,init_ts) := true;
            next_version(T,U) := false;
            ts_value(T,V) := T = init_ts & V = init_value;
            ts_rmw(T) := false;
            rmw_conflict(T) := false;
            write_conflict(T) := false;

            inv_write(S,T,V) := false;
            inv_rmw(S,T,V) := false;
            ack_msg(A,C,T) := false;
            val_msg(T) := T = init_ts;
            o3_quorum(N,C,T) := false;
            complete_try(N) := false;
            o3_try(N,C,T) := false;
            completed(T) := T = init_ts;
        }

        # O3 broadcast-ACK optimization. Followers broadcast ACKs, so a replica
        # can remember that it has seen a full live ACK set even before its
        # matching INV has arrived. For RMW timestamps, this is only a candidate:
        # completion still has to re-check the completed-RMW conflict guard.
        before o3_observe_quorum {
            require live(n);
            require live(c);
            require seen_ts(t);
            require live(A) & A ~= c -> ack_msg(A,c,t);
            require live(c) -> le(t,cur_ts(c));
            require live(c) & ts_rmw(t) & parent(t,B) & cur_rmw(c) & parent(cur_ts(c),B) -> cur_ts(c) = t;
            require live(c) & ts_rmw(t) & parent(t,B) & ~cur_rmw(c) & parent(cur_ts(c),B) -> false;
            require live(c) & ts_rmw(t) & parent(t,B) & pending(c) & pending_rmw(c) & parent(pending_ts(c),B) -> pending_ts(c) = t;
            require live(c) & ts_rmw(t) & parent(t,B) & pending(c) & ~pending_rmw(c) & parent(pending_ts(c),B) -> false;
            require live(c) & ts_rmw(t) & cur_rmw(c) & same_parent(t,cur_ts(c)) -> cur_ts(c) = t;
            require live(c) & ts_rmw(t) & ~cur_rmw(c) & same_parent(t,cur_ts(c)) -> false;
            require live(c) & ts_rmw(t) & pending(c) & pending_rmw(c) & same_parent(t,pending_ts(c)) -> pending_ts(c) = t;
            require live(c) & ts_rmw(t) & pending(c) & ~pending_rmw(c) & same_parent(t,pending_ts(c)) -> false;

            o3_quorum(n,c,t) := true;
        }

        # Once the matching INV has installed timestamp t locally, the remembered
        # ACK quorum is enough to infer validity without waiting for VALIDATE.
        before o3_complete {
            require live(n);

            o3_try(n,c,t) := true;
            o3_try(N,C,T) := false;

            if cur_ts(n) = t & state(n) ~= hs_valid & o3_quorum(n,c,t) & ~rmw_conflict(t) & ~write_conflict(t) {
                completed(t) := true;
                rmw_conflict(T) := rmw_conflict(T) |
                    (ts_rmw(T) & T ~= t & same_version(t,T)) |
                    (~ts_rmw(t) & ts_rmw(T) & (same_version(T,t) | next_version(t,T)));
                write_conflict(T) := write_conflict(T) |
                    (ts_rmw(t) & ~ts_rmw(T) & (same_version(t,T) | next_version(T,t)));
                state(n) := hs_valid;

                if pending(n) & pending_ts(n) = t {
                    if ready(n) {
                        epoch_done(E) := epoch_done(E) | E = ready_epoch(n);
                    };
                    pending(n) := false;
                    pending_rmw(n) := false;
                    acked(n,A) := false;
                    ready(n) := false;
                };
            }
        }

        invariant ready(N) -> live(N)
        invariant ready(N) -> seen_epoch(ready_epoch(N))
        invariant ready(N) -> ready_epoch(N) ~= init_epoch
        invariant ready(N) -> ready_epoch_active(ready_epoch(N))
        invariant epoch_done(E) -> seen_epoch(E)
        invariant ready_epoch_active(E) -> seen_epoch(E)
        invariant ~complete_try(N)
        invariant ~o3_try(N,C,T)
        invariant ready_task = ready_finish
        invariant o3_task = o3_finish
        explicit temporal property [o3_rmw_ack_quorums_eventually_finish_or_conflict]
        forall N,C,T. (globally eventually o3_try(N,C,T)) ->
            globally ~(o3_quorum(N,C,T) & ts_rmw(T) & cur_ts(N) = T & state(N) ~= hs_valid & ~completed(T) & ~rmw_conflict(T) & globally (cur_ts(N) = T & state(N) ~= hs_valid & ~completed(T) & ~rmw_conflict(T)))
        proof {
            tactic skolemize;
            tactic l2s_auto5 with {
                definition work_created(Q) = Q = o3_task
                definition work_needed(Q) = Q = o3_task & o3_quorum(_N,_C,_T) & ts_rmw(_T) & cur_ts(_N) = _T & state(_N) ~= hs_valid & ~completed(_T) & ~rmw_conflict(_T)
                definition work_done(Q) = Q = o3_task & (completed(_T) | state(_N) = hs_valid | cur_ts(_N) ~= _T | rmw_conflict(_T))
                definition work_invar = o3_quorum(_N,_C,_T) & ts_rmw(_T) & cur_ts(_N) = _T & state(_N) ~= hs_valid & ~completed(_T) & ~rmw_conflict(_T)
                definition work_start = o3_quorum(_N,_C,_T) & ts_rmw(_T) & cur_ts(_N) = _T & state(_N) ~= hs_valid & ~completed(_T) & ~rmw_conflict(_T) & globally (cur_ts(_N) = _T & state(_N) ~= hs_valid & ~completed(_T) & ~rmw_conflict(_T))
                definition work_progress = o3_try(_N,_C,_T)
                definition work_helpful = o3_quorum(_N,_C,_T) & ts_rmw(_T) & cur_ts(_N) = _T & state(_N) ~= hs_valid & ~completed(_T) & ~rmw_conflict(_T)
                invariant l2s_saved & ($l2s_s . cur_ts(_N) = _T & state(_N) ~= hs_valid) & ~completed(_T) -> cur_ts(_N) = _T & state(_N) ~= hs_valid
            }
        }
    }
}

export hermes_protocol.local_write
export hermes_protocol.local_rmw
export hermes_protocol.receive_write_inv
export hermes_protocol.receive_rmw_inv
export hermes_protocol.receive_ack
export hermes_protocol.complete_current
export hermes_protocol.complete_overwritten
export hermes_protocol.complete_ready
export hermes_protocol.o3_observe_quorum
export hermes_protocol.o3_complete
export hermes_protocol.mark_ready
export hermes_protocol.receive_validate
export hermes_protocol.replay_after_failure
export hermes_protocol.fail

attribute hermes_protocol.local_write.weight = "2.0"
attribute hermes_protocol.local_rmw.weight = "2.0"
attribute hermes_protocol.receive_write_inv.weight = "2.0"
attribute hermes_protocol.receive_rmw_inv.weight = "2.0"
attribute hermes_protocol.receive_ack.weight = "2.0"
attribute hermes_protocol.complete_current.weight = "1.5"
attribute hermes_protocol.complete_overwritten.weight = "1.5"
attribute hermes_protocol.complete_ready.weight = "1.0"
attribute hermes_protocol.o3_observe_quorum.weight = "1.5"
attribute hermes_protocol.o3_complete.weight = "1.5"
attribute hermes_protocol.mark_ready.weight = "1.5"
attribute hermes_protocol.receive_validate.weight = "1.5"
attribute hermes_protocol.replay_after_failure.weight = "0.75"
attribute hermes_protocol.fail.weight = "0.75"
