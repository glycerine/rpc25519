        # O3 broadcast-ACK optimization. Followers broadcast ACKs, so a replica
        # can remember that it has seen a full live ACK set even before its
        # matching INV has arrived. For RMW timestamps, this is only a candidate:
        # completion still has to re-check the completed-RMW conflict guard.
        before o3_observe_quorum {
            require live(n);
            require live(c);
            require seen_ts(t);
            require live(A) & A ~= c -> ack_msg(A,c,t);
            require live(c) -> le(t,cur_ts(c));
            require live(c) & ts_rmw(t) & parent(t,B) & cur_rmw(c) & parent(cur_ts(c),B) -> cur_ts(c) = t;
            require live(c) & ts_rmw(t) & parent(t,B) & ~cur_rmw(c) & parent(cur_ts(c),B) -> false;
            require live(c) & ts_rmw(t) & parent(t,B) & pending(c) & pending_rmw(c) & parent(pending_ts(c),B) -> pending_ts(c) = t;
            require live(c) & ts_rmw(t) & parent(t,B) & pending(c) & ~pending_rmw(c) & parent(pending_ts(c),B) -> false;
            require live(c) & ts_rmw(t) & cur_rmw(c) & same_parent(t,cur_ts(c)) -> cur_ts(c) = t;
            require live(c) & ts_rmw(t) & ~cur_rmw(c) & same_parent(t,cur_ts(c)) -> false;
            require live(c) & ts_rmw(t) & pending(c) & pending_rmw(c) & same_parent(t,pending_ts(c)) -> pending_ts(c) = t;
            require live(c) & ts_rmw(t) & pending(c) & ~pending_rmw(c) & same_parent(t,pending_ts(c)) -> false;

            o3_quorum(n,c,t) := true;
        }

        # Once the matching INV has installed timestamp t locally, the remembered
        # ACK quorum is enough to infer validity without waiting for VALIDATE.
        before o3_complete {
            require live(n);

            o3_try(n,c,t) := true;
            o3_try(N,C,T) := false;

            if cur_ts(n) = t & state(n) ~= hs_valid & o3_quorum(n,c,t) & ~rmw_conflict(t) & ~write_conflict(t) {
                completed(t) := true;
                rmw_conflict(T) := rmw_conflict(T) |
                    (ts_rmw(T) & T ~= t & same_version(t,T)) |
                    (~ts_rmw(t) & ts_rmw(T) & (same_version(T,t) | next_version(t,T)));
                write_conflict(T) := write_conflict(T) |
                    (ts_rmw(t) & ~ts_rmw(T) & (same_version(t,T) | next_version(T,t)));
                state(n) := hs_valid;

                if pending(n) & pending_ts(n) = t {
                    if ready(n) {
                        epoch_done(E) := epoch_done(E) | E = ready_epoch(n);
                    };
                    pending(n) := false;
                    pending_rmw(n) := false;
                    acked(n,A) := false;
                    ready(n) := false;
                };
            }
        }

