        # Safety invariants
        ################################################################################

        invariant seen_epoch(init_epoch)
        invariant seen_ts(init_ts)
        invariant completed(init_ts)
        invariant ts_value(init_ts,init_value)
        invariant ~ts_rmw(init_ts)
        invariant ~parent(init_ts,B)

        invariant ts_value(T,V1) & ts_value(T,V2) -> V1 = V2
        invariant parent(T,B1) & parent(T,B2) -> B1 = B2
        invariant parent(T,B) -> seen_ts(T) & seen_ts(B) & lt(B,T)
        invariant same_parent(T,U) -> seen_ts(T) & seen_ts(U)
        invariant same_parent(T,U) -> T ~= init_ts & U ~= init_ts
        invariant same_parent(T,U) -> same_parent(U,T)
        invariant same_parent(T,U) & parent(T,B1) & parent(U,B2) -> B1 = B2
        invariant same_parent(T,U) & parent(T,B) -> parent(U,B)
        invariant same_parent(T,U) & parent(U,B) -> parent(T,B)
        invariant parent(T,B) & parent(U,B) & T ~= U -> same_parent(T,U)
        invariant ts_version(T,V1) & ts_version(T,V2) -> V1 = V2
        invariant ts_version(T,V) -> seen_ts(T)
        invariant seen_ts(T) -> same_version(T,T)
        invariant same_version(T,U) -> seen_ts(T) & seen_ts(U)
        invariant same_version(T,U) -> same_version(U,T)
        invariant same_version(T,U) & same_version(U,V) -> same_version(T,V)
        invariant same_version(T,U) & ts_version(T,V) -> ts_version(U,V)
        invariant ts_version(T,V) & ts_version(U,V) -> same_version(T,U)
        invariant next_version(T,U) -> seen_ts(T) & seen_ts(U)
        invariant next_version(T,U) -> ~same_version(T,U)
        invariant next_version(T,U) & ts_version(T,TV) & ts_version(U,UV) -> UV < TV
        invariant ts_version(T,TV) & ts_version(U,UV) & TV < UV -> lt(T,U)
        invariant ts_value(T,V) -> seen_ts(T)
        invariant ts_rmw(T) -> seen_ts(T)
        invariant rmw_conflict(T) -> seen_ts(T)
        invariant rmw_conflict(T) -> ts_rmw(T)
        invariant write_conflict(T) -> seen_ts(T)
        invariant write_conflict(T) -> ~ts_rmw(T)
        invariant inv_write(S,T,V) -> live(S) & seen_ts(T) & ts_value(T,V) & ~ts_rmw(T)
        invariant inv_rmw(S,T,V) -> live(S) & seen_ts(T) & ts_value(T,V) & ts_rmw(T)
        invariant ~ack_msg(N,N,T)
        invariant ack_msg(A,C,T) -> live(A) & live(C)
        invariant ack_msg(A,C,T) -> seen_ts(T)
        invariant ack_msg(A,C,T) -> le(T,cur_ts(A))
        invariant val_msg(T) -> completed(T)
        invariant completed(T) -> seen_ts(T)
        invariant o3_quorum(N,C,T) -> live(C)
        invariant o3_quorum(N,C,T) & live(A) & A ~= C -> ack_msg(A,C,T)
        invariant o3_quorum(N,C,T) & live(C) -> le(T,cur_ts(C))
        invariant o3_quorum(N,C,T) -> seen_ts(T)
        invariant seen_ts(cur_ts(N))
        invariant ts_value(cur_ts(N),cur_value(N))
        invariant cur_rmw(N) -> ts_rmw(cur_ts(N))
        invariant ~cur_rmw(N) -> ~ts_rmw(cur_ts(N))
        invariant pending(N) -> live(N)
        invariant pending(N) -> seen_ts(pending_ts(N))
        invariant pending(N) -> acked(N,N)
        invariant pending(N) -> le(pending_ts(N),cur_ts(N))
        invariant pending(N) & pending_rmw(N) -> ts_rmw(pending_ts(N))
        invariant pending(N) & ~pending_rmw(N) -> ~ts_rmw(pending_ts(N))
        invariant pending(N) & pending_rmw(N) -> pending_ts(N) = cur_ts(N)
        invariant pending(N) & pending_rmw(N) -> cur_rmw(N)
        invariant pending(N) & acked(N,A) -> le(pending_ts(N),cur_ts(A))
        invariant ready(N) -> pending(N)
        invariant ready(N) & live(A) -> acked(N,A)
        invariant ready(N) -> pending_ts(N) = cur_ts(N) | lt(pending_ts(N),cur_ts(N))
        invariant ready(N) & pending_ts(N) = cur_ts(N) -> state(N) = hs_write | state(N) = hs_replay
        invariant ready(N) & lt(pending_ts(N),cur_ts(N)) -> state(N) = hs_invalid_write | state(N) = hs_invalid | state(N) = hs_valid
        invariant pending(N) & pending_ts(N) = cur_ts(N) -> state(N) = hs_write | state(N) = hs_replay
        invariant pending(N) & lt(pending_ts(N),cur_ts(N)) -> state(N) = hs_invalid_write | state(N) = hs_invalid | state(N) = hs_valid
        invariant ~pending(N) -> ~acked(N,A)
        invariant ~pending(N) -> ~pending_rmw(N)
        invariant ~pending(N) -> ~ready(N)
        invariant client_write_pending(N) -> live(N)
        invariant client_rmw_pending(N) -> live(N)

        # Once a timestamp is completed, every live node has advanced to at
        # least that timestamp. This is the key invariant behind valid/valid
        # consistency.
        invariant completed(T) & live(N) -> le(T,cur_ts(N))

        invariant state(N) = hs_valid -> completed(cur_ts(N))

        # Read-state agreement for the one modeled key: any two live replicas
        # that can serve local reads agree on timestamp and value.
        invariant live(N1) & live(N2) & state(N1) = hs_valid & state(N2) = hs_valid -> cur_ts(N1) = cur_ts(N2)
        invariant live(N1) & live(N2) & state(N1) = hs_valid & state(N2) = hs_valid -> cur_value(N1) = cur_value(N2)

        # A live node may retain a pending/ready conflicting operation, but it
        # must already be marked conflicted so it cannot complete.
        invariant live(N) & pending(N) & pending_rmw(N) & completed(R) & ts_rmw(R) & same_version(pending_ts(N),R) -> pending_ts(N) = R | rmw_conflict(pending_ts(N))
        invariant live(N) & pending(N) & pending_rmw(N) & completed(W) & ~ts_rmw(W) & (same_version(pending_ts(N),W) | next_version(W,pending_ts(N))) -> rmw_conflict(pending_ts(N))
        invariant live(N) & pending(N) & ~pending_rmw(N) & completed(R) & ts_rmw(R) & (same_version(pending_ts(N),R) | next_version(pending_ts(N),R)) -> write_conflict(pending_ts(N))
        invariant live(N) & ready(N) & pending_rmw(N) & completed(R) & ts_rmw(R) & same_version(pending_ts(N),R) -> pending_ts(N) = R | rmw_conflict(pending_ts(N))
        invariant live(N) & ready(N) & pending_rmw(N) & completed(W) & ~ts_rmw(W) & (same_version(pending_ts(N),W) | next_version(W,pending_ts(N))) -> rmw_conflict(pending_ts(N))
        invariant live(N) & ready(N) & pending(N) & ~pending_rmw(N) & completed(R) & ts_rmw(R) & (same_version(pending_ts(N),R) | next_version(pending_ts(N),R)) -> write_conflict(pending_ts(N))

        # RMW safety: the TLA semantics are version-based. A completed RMW
        # conflicts with any other RMW at the same version and with blind writes
        # at either the same version or the immediately following version.
        invariant completed(R) & ts_rmw(R) & ts_rmw(T) & same_version(R,T) & R ~= T -> rmw_conflict(T)
        invariant completed(W) & ~ts_rmw(W) & ts_rmw(T) & (same_version(W,T) | next_version(W,T)) -> rmw_conflict(T)
        invariant completed(R) & ts_rmw(R) & ~ts_rmw(W) & (same_version(R,W) | next_version(W,R)) -> write_conflict(W)
        invariant completed(R1) & completed(R2) & ts_rmw(R1) & ts_rmw(R2) & same_version(R1,R2) -> R1 = R2
        invariant completed(R) & ts_rmw(R) & completed(W) & ~ts_rmw(W) & (same_version(R,W) | next_version(W,R)) -> false

        ################################################################################
